rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && userDoc().role == 'admin'; }
    function isEditorOrAdmin() {
      return signedIn() && userDoc().role in ['admin', 'editor'];
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /projects/{projectId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /{collection}/{docId} {
        allow read: if signedIn();
        allow write: if isEditorOrAdmin();
      }
    }
  }
}
